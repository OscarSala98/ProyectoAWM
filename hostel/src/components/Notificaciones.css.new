.notificaciones-container {
  margin: 2rem;
  border-radius: 10px;
  overflow: hidden;
  max-width: 800px;
}

.notificaciones-header {
  background-color: #f8f8d8;
  padding: 1rem;
  border-radius: 12px 12px 0 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.notificaciones-header h3 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.badge-sin-leer {
  background-color: #ff4444;
  color: white;
  border-radius: 50%;
  padding: 0.2rem 0.5rem;
  font-size: 0.8rem;
  min-width: 20px;
  text-align: center;
}

.btn-recargar {
  background: none;
  border: none;
  font-size: 1.2rem;
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.btn-recargar:hover {
  background-color: rgba(0, 0, 0, 0.1);
}

.sin-notificaciones {
  background-color: white;
  padding: 2rem;
  text-align: center;
  color: #666;
  border-radius: 0 0 12px 12px;
}

.notificaciones-lista {
  list-style: none;
  margin: 0;
  padding: 0;
  background-color: white;
  border-radius: 0 0 12px 12px;
}

.notificacion-item {
  display: flex;
  align-items: flex-start;
  padding: 1rem;
  border-bottom: 1px solid #eee;
  transition: background-color 0.2s;
  gap: 1rem;
}

.notificacion-item:hover {
  background-color: #f9f9f9;
}

.notificacion-item.sin-leer {
  background-color: #f0f8ff;
  border-left: 4px solid #007bff;
}

.notificacion-item.leida {
  background-color: white;
  opacity: 0.8;
}

.notificacion-icono {
  font-size: 1.5rem;
  margin-top: 0.2rem;
}

.notificacion-contenido {
  flex: 1;
}

.notificacion-titulo {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.notificacion-titulo strong {
  font-size: 1rem;
  color: #333;
}

.notificacion-tipo {
  background-color: #e9ecef;
  color: #495057;
  padding: 0.2rem 0.5rem;
  border-radius: 12px;
  font-size: 0.75rem;
  text-transform: capitalize;
}

.notificacion-fecha {
  margin: 0;
  font-size: 0.85rem;
  color: #666;
}

.notificacion-acciones {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.btn-marcar-leida,
.btn-eliminar {
  background: none;
  border: none;
  padding: 0.5rem;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1rem;
  transition: background-color 0.2s;
}

.btn-marcar-leida:hover {
  background-color: #e3f2fd;
}

.btn-eliminar:hover {
  background-color: #ffebee;
}

/* Responsive */
@media (max-width: 768px) {
  .notificaciones-container {
    margin: 1rem;
  }
  
  .notificacion-item {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .notificacion-titulo {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .notificacion-acciones {
    align-self: flex-end;
  }
}
